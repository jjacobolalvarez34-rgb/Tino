# Copie este archivo como .env.local (nunca entra al repositorio) o ponga estas
# variables en Vercel → Project → Settings → Environment Variables.
# Solo la llave pública (anon): la de servicio nunca va al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=llave-publica
# Solo para el servidor (pantalla Usuarios: crear accesos). En Vercel va como variable normal,
# SIN el prefijo NEXT_PUBLIC_, así nunca llega al navegador. Nunca en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=llave-secreta
