# Copia este archivo como .env y llena los valores. El .env nunca se sube.
SUPABASE_URL=
# Llave pública (anon o publishable): la usa el programa, siempre con RLS.
SUPABASE_ANON_KEY=
# Se salta RLS: solo en procesos del servidor, nunca en el navegador ni en la app.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión para aplicar migraciones (Session pooler), con la contraseña de la base.
SUPABASE_DB_URL=
